{
  "name": "trainerhub",
  "private": true,
  "description": "Hebrew RTL workout builder and live workout-mode demo",
  "scripts": {
    "test": "node --test test/*.js",
    "validate:exercises": "node scripts/validate-exercises.js",
    "test:e2e": "playwright test",
    "check:deadcode": "knip",
    "check:size": "size-limit",
