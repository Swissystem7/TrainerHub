    "check:html": "node scripts/check-html.js",
    "doctor": "node scripts/doctor.js",
    "check:a11y-static": "node scripts/check-a11y-static.js",
    "check:i18n": "node scripts/check-i18n.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "14.3.0",
    "jsqr": "1.4.0",
    "knip": "6.45.1",
    "playwright": "1.64.1",
    "size-limit": "14.3.0"
  }
}
