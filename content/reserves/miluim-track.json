  "demos": [
    {
      "id": "demo-hr-pushups",
      "exercise_id": "miluim-hr-pushups",
      "name_he": "שכיבת סמיכה עם ניתוק ידיים",
      "priority": 1,
      "focus_he": "טכניקת ACFT/GoArmy — קו ישר, נעילת מרפקים, חזה+ירכיים לרצפה, ידיים ל־T",
      "verified": false,
      "technique_he": [
        "התחלה על הבטן: ידיים שטוחות, אצבעות מורה בתוך קו הכתפיים; חזה וירכיים על הרצפה; כפות רגליים יחד או עד רוחב מגף.",
        "עלייה: דחיפת כל הגוף כיחידה אחת עד יישור מלא של המרפקים (Front Leaning Rest) — קו ישר מראש עד קרסוליים.",
        "ירידה: כיפוף מרפקים עד שהחזה והירכיים נוגעים ברצפה יחד.",
        "ניתוק ידיים ל־T: בלי להזיז ראש/גוף/רגליים — יישור שתי הזרועות לצדדים. מותר להחליק ידיים על הרצפה.",
        "החזרת ידיים מתחת לכתפיים = סיום חזרה. מנוחה מותרת רק בנעילת מרפקים למעלה או בתחתית עם ידיים מנותקות."
      ],
      "steps_he": [
        "שלב 1 — פלאנק / שכיבות סמיכה לקיר או על ברכיים: בניית קו ישר ונעילת מרפקים.",
        "שלב 2 — שכיבות סמיכה מלאות איטיות: 4–6 סטים × 3–6 חזרות באיכות גבוהה.",
        "שלב 3 — סטים ב־50–70% מהמקסימום (עצירה לפני כשל) + עצירה קצרה בתחתית.",
        "שלב 4 — ניתוק ידיים מלא ל־T בכל חזרה; ספירה רק כשחזה+ירכיים נגעו והידיים יצאו ל־T.",
        "שלב 5 — בדיקת מקס שבועית (או כל 7–10 ימים) לקראת יעד ≥15."
      ],
      "cues_he": [
        "כל שבירה בקו הישר = חזרה לא נספרת.",
        "נעילת מרפקים מלאה למעלה לפני הירידה.",
        "T מלא — לא רק הרמת כפות ידיים קצת."
      ]
