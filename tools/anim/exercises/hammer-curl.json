    { "t": 1.5, "pose": "rest", "ease": "inOutSine" },
    { "t": 1.6, "pose": "rest", "ease": "linear" },
    { "t": 2.2, "pose": "farUp", "ease": "inOutSine" },
    { "t": 2.4, "pose": "farUp", "ease": "linear" },
